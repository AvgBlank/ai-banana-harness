{
  "name": "banana-harness-desktop",
  "productName": "Banana Harness",
  "appId": "io.github.avgblank.banana-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for the Banana Harness coding agent",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "biome check . && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && node scripts/check-tokens.mjs && node scripts/check-versions.mjs",
    "test": "vitest run",
    "tokens:check": "node scripts/check-tokens.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.8.0",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
